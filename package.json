{
  "name": "corpmind-ai",
  "version": "1.0.0",
  "description": "CorpMind AI - Enterprise AI Operations & Workflow Automation Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "fullstack": "npm run dev",
    "frontend": "npm run dev --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "backend:start": "npm start --prefix backend",
    "backend:init-db": "npm run init-db --prefix backend"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
