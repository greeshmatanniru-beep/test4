{
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://test4-m9ow.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://test4-m9ow.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
